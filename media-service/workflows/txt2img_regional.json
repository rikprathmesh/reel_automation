{
  "_comment": "Two characters, each conditioned by ITS OWN reference image on its own side of the frame (IP-Adapter attention masks), instead of one merged reference that blends them into a hybrid. Character A = left, B = right, soft overlap in the middle. REF_START > 0 lets the text prompt lay out background, positions and action before identity is applied. SD1.5 + LCM-LoRA, core mask nodes + ComfyUI_IPAdapter_plus.",
  "4": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "{{CHECKPOINT}}" } },
  "13": { "class_type": "LoraLoader", "inputs": { "lora_name": "{{LCM_LORA}}", "strength_model": 1.0, "strength_clip": 1.0, "model": ["4", 0], "clip": ["4", 1] } },
  "14": { "class_type": "ModelSamplingDiscrete", "inputs": { "sampling": "lcm", "zsnr": false, "model": ["13", 0] } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE}}" } },
  "15": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_B}}" } },
  "11": { "class_type": "IPAdapterUnifiedLoader", "inputs": { "preset": "PLUS (high strength)", "model": ["14", 0] } },
  "40": { "class_type": "SolidMask", "inputs": { "value": 0.0, "width": "{{WIDTH}}", "height": "{{HEIGHT}}" } },
  "41": { "class_type": "SolidMask", "inputs": { "value": 1.0, "width": "{{MASK_W}}", "height": "{{HEIGHT}}" } },
  "42": { "class_type": "MaskComposite", "inputs": { "destination": ["40", 0], "source": ["41", 0], "x": 0, "y": 0, "operation": "add" } },
  "43": { "class_type": "MaskComposite", "inputs": { "destination": ["40", 0], "source": ["41", 0], "x": "{{RIGHT_X}}", "y": 0, "operation": "add" } },
  "44": { "class_type": "FeatherMask", "inputs": { "mask": ["42", 0], "left": 0, "top": 0, "right": "{{FEATHER}}", "bottom": 0 } },
  "45": { "class_type": "FeatherMask", "inputs": { "mask": ["43", 0], "left": "{{FEATHER}}", "top": 0, "right": 0, "bottom": 0 } },
  "12": { "class_type": "IPAdapterAdvanced", "inputs": {
    "model": ["11", 0], "ipadapter": ["11", 1], "image": ["10", 0], "attn_mask": ["44", 0],
    "weight": "{{REF_WEIGHT}}", "weight_type": "linear", "combine_embeds": "concat", "start_at": "{{REF_START}}", "end_at": 1.0, "embeds_scaling": "V only" } },
  "16": { "class_type": "IPAdapterAdvanced", "inputs": {
    "model": ["12", 0], "ipadapter": ["11", 1], "image": ["15", 0], "attn_mask": ["45", 0],
    "weight": "{{REF_WEIGHT}}", "weight_type": "linear", "combine_embeds": "concat", "start_at": "{{REF_START}}", "end_at": 1.0, "embeds_scaling": "V only" } },
  "5": { "class_type": "EmptyLatentImage", "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{PROMPT}}", "clip": ["13", 1] } },
  "7": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{NEGATIVE}}", "clip": ["13", 1] } },
  "3": { "class_type": "KSampler", "inputs": {
    "seed": "{{SEED}}", "steps": "{{STEPS}}", "cfg": "{{CFG}}", "sampler_name": "lcm", "scheduler": "sgm_uniform", "denoise": 1.0,
    "model": ["16", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0] } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
  "9": { "class_type": "SaveImage", "inputs": { "filename_prefix": "{{PREFIX}}", "images": ["8", 0] } }
}
