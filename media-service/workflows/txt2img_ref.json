{
  "_comment": "SD1.5 + LCM-LoRA, conditioned on the character reference sheet via IPAdapter Plus (custom node: ComfyUI_IPAdapter_plus; models: ipadapter/ip-adapter-plus_sd15.safetensors + clip_vision/CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors).",
  "4": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "{{CHECKPOINT}}" } },
  "13": { "class_type": "LoraLoader", "inputs": { "lora_name": "{{LCM_LORA}}", "strength_model": 1.0, "strength_clip": 1.0, "model": ["4", 0], "clip": ["4", 1] } },
  "14": { "class_type": "ModelSamplingDiscrete", "inputs": { "sampling": "lcm", "zsnr": false, "model": ["13", 0] } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE}}" } },
  "11": { "class_type": "IPAdapterUnifiedLoader", "inputs": { "preset": "PLUS (high strength)", "model": ["14", 0] } },
  "12": { "class_type": "IPAdapterAdvanced", "inputs": {
    "model": ["11", 0], "ipadapter": ["11", 1], "image": ["10", 0],
    "weight": "{{REF_WEIGHT}}", "weight_type": "linear", "combine_embeds": "concat", "start_at": "{{REF_START}}", "end_at": 1.0, "embeds_scaling": "V only" } },
  "5": { "class_type": "EmptyLatentImage", "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{PROMPT}}", "clip": ["13", 1] } },
  "7": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{NEGATIVE}}", "clip": ["13", 1] } },
  "3": { "class_type": "KSampler", "inputs": {
    "seed": "{{SEED}}", "steps": "{{STEPS}}", "cfg": "{{CFG}}", "sampler_name": "lcm", "scheduler": "sgm_uniform", "denoise": 1.0,
    "model": ["12", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0] } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
  "9": { "class_type": "SaveImage", "inputs": { "filename_prefix": "{{PREFIX}}", "images": ["8", 0] } }
}
