// ReelForge AI — relational model (docs/IMPLEMENTATION_PLAN.md §5)
// UUID primary keys, created/updated timestamps, soft deletion where appropriate.
// Large files live in storage; only keys + metadata are stored here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/* ============================== enums ============================== */

enum UserRole {
  owner
  editor
  viewer
}

enum ReferenceSource {
  url
  upload
}

enum ReferenceStatus {
  queued
  extracting
  extracted
  analyzing
  analyzed
  needs_upload
  failed
}

enum StoryCategory {
  kids_moral
  emotional
  motivation
  rabbit_squirrel_adventure
  friendship_kindness
  family
  funny_animals
  inspirational
  mahabharat
  ramayan
  shivaji_maharaj
  panchatantra
  hanuman
  krishna
  historical
  travel_exploration
  educational
}

enum Language {
  en
  hi
  hinglish
}

enum AgeGroup {
  age_1_3
  age_4_6
  age_7_10
  general
}

/// where the story came from: AI-invented, the creator's idea, the creator's full text, or the next episode of a story
enum StorySource {
  generated
  idea
  full_story
  continuation
}

enum PromptKind {
  scene_video
  character_reference
}

enum PromptOrigin {
  ai
  ai_improved
  ai_shortened
  ai_expanded
  ai_instructed
  manual
  model_switch
  template
  restored
}

enum StoryStatus {
  draft
  scripted
  in_production
  archived
}

enum ReferenceImageKind {
  sheet
  pose
  expression
  uploaded
  front
  side
  back
  three_quarter
  closeup
}

enum VoiceEngine {
  kokoro
  piper
}

enum MediaKind {
  reference_video
  reference_frame
  character_image
  scene_image
  scene_clip
  voice
  music
  sfx
  subtitle
  video
  thumbnail
  other
}

enum ProjectStatus {
  queued
  generating
  awaiting_review
  approved
  rejected
  changes_requested
  publishing
  published
  failed
}

enum GenerationStage {
  story
  storyboard
  voice
  animation
  audio
  editing
  render
  validation
}

enum JobStatus {
  queued
  active
  retrying
  completed
  failed
  cancelled
}

enum VersionStatus {
  rendering
  ready
  approved
  rejected
  changes_requested
  superseded
  failed
}

enum SceneJobStatus {
  queued
  active
  completed
  failed
}

enum ApprovalDecision {
  approved
  rejected
  changes_requested
}

enum Platform {
  youtube
  instagram
}

enum AccountStatus {
  connected
  expired
  revoked
  error
}

enum PublishStatus {
  scheduled
  queued
  uploading
  published
  failed
  cancelled
  manual_required
}

enum LogLevel {
  info
  warn
  error
}

/* ============================== identity ============================== */

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  displayName  String
  role         UserRole      @default(owner)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  approvals    Approval[]
  activities   ActivityLog[]
}

/* ============================== references ============================== */

model ReferenceVideo {
  id           String             @id @default(uuid()) @db.Uuid
  url          String?
  platform     String
  source       ReferenceSource
  status       ReferenceStatus    @default(queued)
  category     StoryCategory?
  title        String?
  author       String?
  caption      String?
  transcript   String?
  durationSec  Float?
  metadata     Json?
  extractor    String?
  error        String?
  thumbnailKey String?
  videoAssetId String?            @db.Uuid
  videoAsset   MediaAsset?        @relation("ReferenceVideoAsset", fields: [videoAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  analysis     ReferenceAnalysis?
  stories      Story[]            @relation("StoryReferences")

  @@index([status])
  @@index([category])
}

model ReferenceAnalysis {
  id               String         @id @default(uuid()) @db.Uuid
  referenceId      String         @unique @db.Uuid
  reference        ReferenceVideo @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  summary          String
  hook             Json
  structure        Json
  pacing           Json
  transitions      Json
  visualStyle      Json
  characterTraits  Json
  narration        Json
  emotionalArc     String
  retentionTactics String[]
  doNotCopy        String[]
  model            String
  promptVersion    String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/* ============================== stories ============================== */

model Story {
  id                 String           @id @default(uuid()) @db.Uuid
  title              String
  category           StoryCategory
  language           Language         @default(en)
  targetAudience     String
  emotionalObjective String
  hook               String
  moral              String
  /// normalized premise used to reject near-duplicate concepts
  conceptFingerprint String
  status             StoryStatus      @default(draft)
  /// visual style preset id (src/common/styles.ts); one style per reel
  style              String           @default("storybook")
  /// requested reel length in seconds (60 / 120 / 180); null on stories made before lengths existed
  targetDurationSec  Int?
  model              String?
  ageGroup           AgeGroup         @default(age_4_6)
  sourceMode         StorySource      @default(generated)
  /// the creator's idea or full story text, kept verbatim (never rewritten by the AI)
  sourceText         String?
  /// story bible from the understanding engine: characters, locations, objects, chronological events, moral
  understanding      Json?
  parentStoryId      String?          @db.Uuid
  parent             Story?           @relation("Episodes", fields: [parentStoryId], references: [id], onDelete: SetNull)
  episodes           Story[]          @relation("Episodes")
  episodeNo          Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  references         ReferenceVideo[] @relation("StoryReferences")
  scripts            StoryScript[]
  projects           VideoProject[]

  @@index([category, createdAt])
  @@index([conceptFingerprint])
}

model StoryScript {
  id                String        @id @default(uuid()) @db.Uuid
  storyId           String        @db.Uuid
  story             Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  version           Int
  isCurrent         Boolean       @default(true)
  narration         String
  musicDirection    String
  voiceInstructions String
  ending            String
  youtubeTitle      String
  youtubeDescription String
  instagramCaption  String
  hashtags          String[]
  feedback          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  scenes            StoryScene[]
  versions          VideoVersion[]

  @@unique([storyId, version])
}

model StoryScene {
  id           String                @id @default(uuid()) @db.Uuid
  scriptId     String                @db.Uuid
  script       StoryScript           @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  index        Int
  description  String
  visualPrompt String
  camera       String
  transition   String
  sfx          String
  onScreenText String
  dialogue     Json
  durationHint Float
  title        String                @default("")
  location     String                @default("")
  /// story-bible event numbers this scene shows (faithfulness check)
  events       Int[]                 @default([])
  /// clip made outside ReelForge (Google Flow / Veo) and uploaded for this scene; used instead of the local picture + voices
  clipAssetId  String?               @db.Uuid
  clipAsset    MediaAsset?           @relation("SceneClip", fields: [clipAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  characters   StorySceneCharacter[]
  prompts      GeneratedPrompt[]
  sceneJobs    SceneGenerationJob[]

  @@unique([scriptId, index])
}

model StorySceneCharacter {
  sceneId          String     @db.Uuid
  scene            StoryScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId      String     @db.Uuid
  character        Character  @relation(fields: [characterId], references: [id], onDelete: Restrict)
  expressionPreset String?

  @@id([sceneId, characterId])
}

/* ============================== characters & voices ============================== */

model Character {
  id                String                    @id @default(uuid()) @db.Uuid
  name              String                    @unique
  description       String
  appearance        String
  furColors         String
  clothingColors    String
  personality       String
  basePrompt        String
  negativePrompt    String                    @default("")
  seed              Int
  expressionPresets Json                      @default("{}")
  isStoryteller     Boolean                   @default(false)
  active            Boolean                   @default(true)
  voiceProfileId    String?                   @db.Uuid
  voiceProfile      VoiceProfile?             @relation("CharacterVoice", fields: [voiceProfileId], references: [id], onDelete: SetNull)
  /// voice used when the story is in Hindi (Devanagari); falls back to voiceProfile if it is already Hindi
  hindiVoiceProfileId String?                 @db.Uuid
  hindiVoiceProfile VoiceProfile?             @relation("CharacterHindiVoice", fields: [hindiVoiceProfileId], references: [id], onDelete: SetNull)
  /// story categories this character belongs to; empty = the general kids' cast (not used in epic stories)
  categories        StoryCategory[]           @default([])
  /// species / character type, e.g. "baby lion", "human boy"
  species           String                    @default("")
  /// permanent identity: proportions, face, eyes, surface, clothing, accessories, colours, expressions, motion style
  visualProfile     Json?
  /// model-ready identity tags restated in every scene prompt (derived from visualProfile)
  identityPrompt    String                    @default("")
  preferredModel    String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  referenceImages   CharacterReferenceImage[]
  scenes            StorySceneCharacter[]
  prompts           GeneratedPrompt[]
}

model CharacterReferenceImage {
  id           String             @id @default(uuid()) @db.Uuid
  characterId  String             @db.Uuid
  character    Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mediaAssetId String             @db.Uuid
  mediaAsset   MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  kind         ReferenceImageKind
  isPrimary    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([characterId])
}

model VoiceProfile {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  engine     VoiceEngine
  voiceId    String
  language   Language
  speed      Float       @default(1.0)
  style      String      @default("")
  isNarrator Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  characters Character[] @relation("CharacterVoice")
  hindiCharacters Character[] @relation("CharacterHindiVoice")
}

/* ============================== media ============================== */

model MediaAsset {
  id              String                    @id @default(uuid()) @db.Uuid
  kind            MediaKind
  storageKey      String                    @unique
  mime            String
  bytes           BigInt
  sha256          String
  width           Int?
  height          Int?
  durationSec     Float?
  provider        String?
  meta            Json?
  projectId       String?                   @db.Uuid
  project         VideoProject?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deletedAt       DateTime?
  characterImages CharacterReferenceImage[]
  references      ReferenceVideo[]          @relation("ReferenceVideoAsset")
  videoOf         VideoVersion[]            @relation("VersionVideo")
  thumbnailOf     VideoVersion[]            @relation("VersionThumbnail")
  sceneClips      StoryScene[]              @relation("SceneClip")

  @@index([projectId, kind])
}

/* ============================== production ============================== */

model VideoProject {
  id              String               @id @default(uuid()) @db.Uuid
  storyId         String               @db.Uuid
  story           Story                @relation(fields: [storyId], references: [id], onDelete: Restrict)
  scheduleRunId   String?              @db.Uuid
  scheduleRun     ScheduleRun?         @relation(fields: [scheduleRunId], references: [id], onDelete: SetNull)
  status          ProjectStatus        @default(queued)
  targetPlatforms Platform[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  jobs            VideoGenerationJob[]
  versions        VideoVersion[]
  assets          MediaAsset[]

  @@index([status])
}

model VideoGenerationJob {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @db.Uuid
  project     VideoProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bullJobId   String          @unique
  stage       GenerationStage @default(story)
  status      JobStatus       @default(queued)
  progress    Int             @default(0)
  attempt     Int             @default(0)
  maxAttempts Int             @default(2)
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
  @@index([status])
}

model VideoVersion {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  project          VideoProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNo        Int
  scriptId         String           @db.Uuid
  script           StoryScript      @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  status           VersionStatus    @default(rendering)
  videoAssetId     String?          @db.Uuid
  videoAsset       MediaAsset?      @relation("VersionVideo", fields: [videoAssetId], references: [id], onDelete: SetNull)
  thumbnailAssetId String?          @db.Uuid
  thumbnailAsset   MediaAsset?      @relation("VersionThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  durationSec      Float?
  /// ffprobe validation report (resolution, codecs, fps, duration, audio, black frames)
  validation       Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  /// wall-clock timings of this render (scene jobs, merge, total), for measuring the pipeline
  timings          Json?
  approvals        Approval[]
  publishingJobs   PublishingJob[]
  sceneJobs        SceneGenerationJob[]

  @@unique([projectId, versionNo])
  @@index([status])
}

/// Append-only decision log. The publisher re-reads the latest row for a version.
model Approval {
  id         String           @id @default(uuid()) @db.Uuid
  versionId  String           @db.Uuid
  version    VideoVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  decision   ApprovalDecision
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  platforms  Platform[]
  notes      String?
  decidedAt  DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  publishing PublishingJob[]

  @@index([versionId, decidedAt])
}

/* ============================== publishing ============================== */

model PublishingAccount {
  id              String          @id @default(uuid()) @db.Uuid
  platform        Platform        @unique
  accountId       String
  accountName     String
  /// AES-256-GCM ciphertext; never returned by the API
  encryptedTokens String
  scopes          String[]
  status          AccountStatus   @default(connected)
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  jobs            PublishingJob[]
}

model PublishingJob {
  id             String            @id @default(uuid()) @db.Uuid
  versionId      String            @db.Uuid
  version        VideoVersion      @relation(fields: [versionId], references: [id], onDelete: Restrict)
  approvalId     String            @db.Uuid
  approval       Approval          @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  accountId      String?           @db.Uuid
  account        PublishingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  platform       Platform
  status         PublishStatus     @default(queued)
  scheduledFor   DateTime?
  idempotencyKey String            @unique
  bullJobId      String?
  attempts       Int               @default(0)
  lastError      Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  published      PublishedVideo?

  /// a version can be published at most once per platform
  @@unique([versionId, platform])
  @@index([status, scheduledFor])
}

model PublishedVideo {
  id              String           @id @default(uuid()) @db.Uuid
  publishingJobId String           @unique @db.Uuid
  publishingJob   PublishingJob    @relation(fields: [publishingJobId], references: [id], onDelete: Restrict)
  platform        Platform
  remoteId        String
  url             String?
  publishedAt     DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  analytics       VideoAnalytics[]

  @@unique([platform, remoteId])
}

model VideoAnalytics {
  id               String         @id @default(uuid()) @db.Uuid
  publishedVideoId String         @db.Uuid
  publishedVideo   PublishedVideo @relation(fields: [publishedVideoId], references: [id], onDelete: Cascade)
  capturedAt       DateTime       @default(now())
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  reach            Int?
  raw              Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([publishedVideoId, capturedAt])
}

/* ============================== automation & system ============================== */

model DailySchedule {
  id             String          @id @default(uuid()) @db.Uuid
  enabled        Boolean         @default(false)
  targetCount    Int             @default(5)
  /// local time "HH:mm"
  startTime      String          @default("01:00")
  timezone       String
  categories     StoryCategory[]
  language       Language        @default(hi)
  /// reel length for scheduled reels, seconds (60 / 120 / 180)
  targetDurationSec Int          @default(60)
  maxConcurrency Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  runs           ScheduleRun[]
}

model ScheduleRun {
  id         String         @id @default(uuid()) @db.Uuid
  scheduleId String         @db.Uuid
  schedule   DailySchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  runDate    String
  planned    Int
  produced   Int            @default(0)
  failed     Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  projects   VideoProject[]

  @@unique([scheduleId, runDate])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  entityType  String
  entityId    String?
  action      String
  level       LogLevel @default(info)
  message     String
  data        Json?
  ip          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([createdAt])
}

/* ============================== prompt engine ============================== */

/// Versioned, structured prompts. One row per (scene | character+view, kind) has isCurrent=true.
/// Prompt operations never modify the story: prompts live here, not in StoryScene.
model GeneratedPrompt {
  id          String       @id @default(uuid()) @db.Uuid
  kind        PromptKind
  sceneId     String?      @db.Uuid
  scene       StoryScene?  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId String?      @db.Uuid
  character   Character?   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// character reference view (front, side, back, three_quarter, closeup, expressions); empty for scenes
  view        String       @default("")
  /// model adapter id (src/prompts/adapters.ts)
  targetModel String
  version     Int
  isCurrent   Boolean      @default(true)
  origin      PromptOrigin
  /// full structured spec (sections A-J)
  spec        Json
  positive    String
  negative    String
  /// instructions the target model cannot follow (shown to the creator, never sent as if supported)
  dropped     String[]     @default([])
  params      Json?
  evaluation  Json?
  score       Int?
  /// the creator's instruction for ai_instructed / the template name for template
  instruction String?
  /// LLM that wrote it
  model       String?
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([sceneId, kind, isCurrent])
  @@index([characterId, kind, isCurrent])
}

/// Reusable craft (camera, look, lighting, negatives) saved from a prompt that worked; never story content.
model PromptTemplate {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @unique
  kind           PromptKind
  targetModel    String
  spec           Json
  notes          String     @default("")
  sourcePromptId String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
}

/// One scene of one render: an independent job (keyframe image, voices, optional AI clip). The version's merge job
/// combines them. Completed scenes survive retries and restarts, and are reused when only one scene is regenerated.
model SceneGenerationJob {
  id            String         @id @default(uuid()) @db.Uuid
  versionId     String         @db.Uuid
  version       VideoVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sceneId       String         @db.Uuid
  scene         StoryScene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  index         Int
  status        SceneJobStatus @default(queued)
  bullJobId     String?
  attempt       Int            @default(0)
  seed          Int
  imageKey      String?
  /// AI-generated clip for this scene; null when the scene is a still (Ken Burns is made at merge time)
  clipKey       String?
  /// [{ line, speaker, key, duration, words }]
  voices        Json?
  promptId      String?        @db.Uuid
  promptVersion Int?
  /// copied unchanged from an earlier version's scene (single-scene regeneration)
  reusedFromId  String?        @db.Uuid
  error         Json?
  /// seconds per step: { image, voice, clip, total }
  timings       Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([versionId, sceneId])
  @@index([versionId, status])
}
