{
  "name": "reelforge-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ReelForge AI backend (NestJS): REST + SSE, auth, approval gate, BullMQ orchestration, publishing",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/unit.test.ts test/gate.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "bullmq": "^5.81.6",
    "cookie-parser": "^1.4.7",
    "googleapis": "^160.0.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
